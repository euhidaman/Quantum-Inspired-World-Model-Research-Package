# Keep source and job scripts portable between Windows and Fir/Linux.
* text=auto
*.sh text eol=lf
*.sbatch text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.bib text eol=lf
*.csv text eol=lf
*.png binary
*.pdf binary
*.pptx binary
*.zip binary

# Preserve the exact bytes recorded in the research provenance manifests.
outputs/** -text
